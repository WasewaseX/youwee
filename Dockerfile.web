FROM oven/bun:1.1-slim AS frontend-builder

WORKDIR /app

COPY package.json bun.lock ./
COPY vite.config.ts ./
COPY tsconfig*.json ./
COPY index.html ./
COPY src/ ./src/
COPY public/ ./public/
COPY postcss.config.js ./
COPY tailwind.config.js ./
COPY components.json ./
COPY biome.json ./

RUN bun install --frozen-lockfile

RUN bun run build:web

FROM oven/bun:1.1-slim AS server-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "yt-dlp==2024.12.13"

RUN curl -fsSL https://deno.land/install.sh | sh -s v2.0.0
ENV PATH="/root/.deno/bin:${PATH}"

WORKDIR /app

COPY server/package.json server/bun.lock ./
RUN bun install --frozen-lockfile

COPY server/ ./
RUN bun run build

FROM oven/bun:1.1-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "yt-dlp==2024.12.13"

RUN curl -fsSL https://deno.land/install.sh | sh -s v2.0.0
ENV PATH="/root/.deno/bin:${PATH}"

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=10000
ENV VITE_WEB_MODE=true

COPY --from=server-builder /app/dist ./dist
COPY --from=server-builder /app/node_modules ./node_modules
COPY --from=server-builder /app/package.json ./
COPY --from=frontend-builder /app/dist ./dist/public

EXPOSE 10000

CMD ["bun", "dist/index.js"]