# Youwee Web Environment Variables

# Web Mode (set to true for web build)
VITE_WEB_MODE=true

# API Base URL (for production, this should be your Render URL)
VITE_API_BASE=https://your-app.onrender.com/api

# ===========================================
# Server (API) Environment Variables
# ===========================================

# Database (PostgreSQL) - required
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for BullMQ queue, sessions, pub/sub) - required
REDIS_URL=redis://user:password@host:6379

# Session secret for JWT signing - required (generate with: openssl rand -base64 32)
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Public app URL for CORS and cookie domain - required
PUBLIC_APP_URL=https://your-app.onrender.com

# S3-compatible object storage (for file uploads) - required
STORAGE_ENDPOINT=https://your-s3-endpoint.com
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=auto

# Node environment
NODE_ENV=production
PORT=10000

# ===========================================
# Worker Environment Variables
# ===========================================
# (Same as server: DATABASE_URL, REDIS_URL, STORAGE_*)

# ===========================================
# Frontend Build Environment Variables
# ===========================================
# VITE_API_BASE should match your deployed API URL