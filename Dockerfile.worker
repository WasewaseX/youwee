FROM oven/bun:1.1-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "yt-dlp==2024.12.13"

RUN curl -fsSL https://deno.land/install.sh | sh -s v2.0.0
ENV PATH="/root/.deno/bin:${PATH}"

WORKDIR /app

COPY worker/package.json worker/bun.lock ./
RUN bun install --frozen-lockfile

COPY worker/ ./
COPY server/src/db ./server/src/db
COPY server/src/queue ./server/src/queue
COPY shared-schema/ ./shared-schema/

RUN bun run build

FROM oven/bun:1.1-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "yt-dlp==2024.12.13"

RUN curl -fsSL https://deno.land/install.sh | sh -s v2.0.0
ENV PATH="/root/.deno/bin:${PATH}"

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/shared-schema ./shared-schema

CMD ["bun", "dist/index.js"]